# ═══════════════════════════════════════════════════════════════════════════════
# Campaign Builder — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
# Copy: cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════════════

APP_ENV=development
APP_NAME=CampaignBuilder
APP_PORT=4000
WEB_PORT=3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campaign_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=campaign_dev
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# JWT — generate: openssl rand -base64 32
JWT_ACCESS_SECRET=change_me_min_32_chars_access_secret
JWT_REFRESH_SECRET=change_me_min_32_chars_refresh_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Encryption — AES-256-GCM key for channel credentials
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=change_me_64_hex_chars_aes_256_key

# Email (Resend)
RESEND_API_KEY=re_your_key_here
EMAIL_FROM=campaigns@yourdomain.com

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
